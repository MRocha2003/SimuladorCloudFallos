@page "/about"

<PageTitle>Acerca del Simulador — SimuladorCloud</PageTitle>

<div style="max-width:800px; margin:32px auto; padding:0 24px;">

    <h2 style="color:#1A56A0; margin-bottom:24px;">
        ℹ Acerca del Simulador
    </h2>

    <div class="card mb-3">
        <h5>Proyecto de Grado</h5>
        <table style="width:100%; font-size:0.9rem; margin-top:8px;">
            <tr><td style="color:#718096; width:180px;">Título:</td>
                <td>Sistema Simulador Web de Fallos en Cascada basado en la Teoría de Grafos para la Gestión Preventiva de Riesgos en Ecosistemas Cloud Públicos</td></tr>
            <tr><td style="color:#718096;">Autor:</td>
                <td>David Manuel Rocha Crespo</td></tr>
            <tr><td style="color:#718096;">Universidad:</td>
                <td>Universidad Adventista de Bolivia (UAB)</td></tr>
            <tr><td style="color:#718096;">Carrera:</td>
                <td>Ingeniería de Sistemas</td></tr>
            <tr><td style="color:#718096;">Año:</td>
                <td>2025 – 2026</td></tr>
            <tr><td style="color:#718096;">Metodología:</td>
                <td>Extreme Programming (XP) — 8 iteraciones de 2 semanas</td></tr>
        </table>
    </div>

    <div class="card mb-3">
        <h5>Tecnologías Utilizadas</h5>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:8px;">
            @foreach (var (tech, desc) in _techs)
            {
                <div style="background:#EEF4FC; border-radius:6px; padding:8px 12px;">
                    <div style="font-weight:600; color:#1A56A0; font-size:0.85rem;">@tech</div>
                    <div style="color:#718096; font-size:0.78rem;">@desc</div>
                </div>
            }
        </div>
    </div>

    <div class="card mb-3">
        <h5>Algoritmos Implementados</h5>
        <ul style="margin-top:8px; padding-left:20px; font-size:0.875rem;">
            <li><strong>BFS/DFS de propagación en cascada</strong> — complejidad O(V+E) — IT-3</li>
            <li><strong>Algoritmo de Tarjan (puntos de articulación)</strong> — detección de SPOFs O(V+E) — IT-4</li>
            <li><strong>Rutas críticas</strong> — camino más largo sobre el grafo acíclico de dependencias, O(V+E) — IT-4/IT-5</li>
        </ul>
    </div>

    <div class="card" style="background:#065F46; color:white; border:none;">
        <h5 style="color:#6EE7B7;">🔒 Entorno Sandbox</h5>
        <p style="font-size:0.875rem; margin-top:8px; color:#A7F3D0;">
            Este simulador opera en un entorno sandbox completamente aislado.
            No se establece ninguna conexión con plataformas Cloud reales
            (AWS, Azure ni Google Cloud). Todas las simulaciones se ejecutan
            íntegramente en el navegador mediante WebAssembly.
        </p>
    </div>

</div>

@code {
    private readonly (string tech, string desc)[] _techs =
    [
        (".NET 8",               "Framework principal"),
        ("Blazor WebAssembly",   "UI + ejecución en cliente"),
        ("C# 12",                "Lenguaje de implementación"),
        ("QuikGraph",            "Algoritmos de grafos"),
        ("Blazored.LocalStorage","Persistencia en navegador"),
        ("SVG nativo",           "Visualización del grafo"),
    ];
}
