@page "/topologies"
@using SimuladorCloud.Client.Models
@using SimuladorCloud.Client.Services
@inject TopologyStorageService StorageService
@inject GraphService GraphService
@inject NavigationManager Nav

<PageTitle>Topologías Guardadas — SimuladorCloud</PageTitle>

<div style="max-width:900px; margin:32px auto; padding:0 24px;">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 style="color:#1A56A0;">📂 Topologías Guardadas</h2>
        <a href="/simulator" class="btn btn-primary">+ Nueva Topología</a>
    </div>

    @if (_loading)
    {
        <div style="text-align:center; padding:40px; color:#718096;">
            Cargando topologías...
        </div>
    }
    else if (_topologies.Count == 0)
    {
        <div class="card" style="text-align:center; padding:40px;">
            <div style="font-size:2.5rem; margin-bottom:12px;">📭</div>
            <h5 style="color:#4A5568;">No hay topologías guardadas</h5>
            <p style="color:#718096; font-size:0.875rem;">
                Ve al simulador, construye una topología y guárdala para verla aquí.
            </p>
            <a href="/simulator" class="btn btn-primary mt-2">Ir al Simulador</a>
        </div>
    }
    else
    {
        <div style="display:grid; gap:12px;">
            @foreach (var topo in _topologies)
            {
                <div class="card" style="display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <h5 style="color:#1A56A0; margin-bottom:4px;">@topo.Name</h5>
                        <span style="color:#718096; font-size:0.8rem;">
                            @topo.NodeCount nodos · @topo.EdgeCount aristas ·
                            Creada: @topo.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </span>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm"
                                @onclick="() => LoadTopology(topo.TopologyId)">
                            ▶ Cargar
                        </button>
                        <button class="btn btn-outline-danger btn-sm"
                                @onclick="() => DeleteTopology(topo.TopologyId)">
                            🗑
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success mt-3 fade-in">@_message</div>
    }

</div>

@code {
    private List<GraphModel> _topologies = new();
    private bool   _loading = true;
    private string _message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _topologies = await StorageService.GetTopologyListAsync();
        _loading    = false;
    }

    private async Task LoadTopology(string id)
    {
        var topo = await StorageService.LoadTopologyAsync(id);
        if (topo is null) return;
        GraphService.LoadGraph(topo);
        Nav.NavigateTo("/simulator");
    }

    private async Task DeleteTopology(string id)
    {
        await StorageService.DeleteTopologyAsync(id);
        _topologies = await StorageService.GetTopologyListAsync();
        _message    = "Topología eliminada correctamente.";
        await Task.Delay(2500);
        _message = string.Empty;
    }
}
